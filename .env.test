# Loaded only by `vite build --mode test` (see `npm run build:test`).
#
# VITE_PUBLIC_DARSHAN lifts the login guard on /darshan so scripts/verify-loading.mjs can
# measure image delivery in a real Chrome without a Supabase session. It is a verifier
# flag, never a production feature: vite.config.js throws if a production build carries
# it, and this file is not read in production mode.
VITE_PUBLIC_DARSHAN=1
