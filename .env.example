# Copy to .env.local and fill in from Firebase Console → Project Settings → Your apps.
# These are public values (they ship to the browser) — see .env.local for why.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Netlify Functions only (server-side). NEVER commit these. ---
# Set in Netlify → Site settings → Environment variables.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
