# Cloudflare Pages headers.
#
# Image filenames embed a hash of their own content (001.a3f9c2d1.avif), so a given
# URL can never point at different bytes. That makes `immutable` safe: the browser
# never revalidates, so a returning yuvak spends zero requests on images already seen.
# Replacing an image changes its hash, hence its filename, so updates still propagate.
/darshan/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shell must stay fresh so new deploys are picked up.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
