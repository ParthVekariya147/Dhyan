node_modules/
dist/
dev-dist/

# Local copies of the artwork. Neither is part of the build any more: દર્શન images are
# served straight from the સંચાલક's Google Drive folder, which is their system of record,
# and nothing in this repository reads these directories. They are kept ignored so an
# existing checkout does not suddenly offer to commit 549 MB of PNG.
originals-archive/
assets/masters/
assets/originals/

.env
.env.local
.env.*.local

# .claude/settings.json is committed — it wires the SessionStart hook that every cloud
# session runs (docs/CLOUD_SETUP.md). The .local file beside it is per-machine permission
# state and is not. It was only ever ignored by a global gitconfig on one machine, which
# stopped being enough the moment .claude/ became a tracked directory: a teammate, or a
# cloud session granting itself a permission, would otherwise offer to commit it.
.claude/settings.local.json
